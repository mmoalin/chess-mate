{
  "name": "chess-opening-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:compile": "node scripts/compile-courses.mjs",
    "content:verify": "node scripts/verify-courses.mjs --side black",
    "prebuild": "npm run content:compile"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@vitejs/plugin-react": "^5.1.2",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-chessboard": "^5.8.3",
    "react-dom": "^19.2.1",
    "stockfish": "^17.1.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
